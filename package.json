{
  "name": "@ddtcorex/dsh-maestro-guard",
  "version": "0.3.0",
  "private": false,
  "packageManager": "pnpm@11.7.0",
  "description": "Maestro Guard — pre-execute safety gate: native DSH approval prompts, parsed command-surface rules, decision journal",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@ddtcorex/dsh-maestro-config-lib": "workspace:^0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  }
}
